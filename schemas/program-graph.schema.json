      },
      "title": "Nodes",
      "type": "object"
    },
    "edges": {
      "items": {
        "$ref": "#/$defs/Edge"
      },
      "title": "Edges",
      "type": "array"
    }
  },
  "title": "ProgramGraph",
  "type": "object"
